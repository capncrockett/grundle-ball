{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --ci",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "pretest:e2e:local": "npm run build",
    "test:e2e:local": "cross-env E2E_BASE_URL=http://localhost:5173 PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:e2e:headed": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test --headed",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --noEmit --project tsconfig.node.json",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "fetch:matchups": "ts-node --project ../backend/tsconfig.json --esm ../backend/scripts/updateMatchupHistory.ts",
    "fetch:drafts": "ts-node --project ../backend/tsconfig.json --esm ../backend/scripts/updateDraftHistory.ts"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/whatwg-fetch": "^0.0.33",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.22",
    "cross-env": "^10.1.0",
    "daisyui": "^5.5.5",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "msw": "2.12.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "undici": "^8.10.0",
    "vite": "^8.2.2",
    "whatwg-fetch": "^3.6.20"
  }
}
