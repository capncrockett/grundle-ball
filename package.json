{
  "name": "grundle-ball",
  "version": "2.4.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "repo:check": "node scripts/check-repo.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "npm run format -w frontend",
    "format:write": "npm run format:write -w frontend",
    "lint": "npm run lint -w frontend && npm run lint -w backend",
    "prepare": "node .husky/install.mjs",
    "typecheck": "npm run typecheck -w frontend && npm run typecheck -w backend"
  },
  "lint-staged": {
    "*.{cjs,css,html,js,json,jsx,md,mjs,ts,tsx,yaml,yml}": "prettier --config frontend/.prettierrc --write"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "17.4.1"
  }
}
